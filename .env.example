TELEGRAM_BOT_TOKEN=123456789:replace_with_botfather_token
ALLOWED_TELEGRAM_USER_ID=0
# Для Hiddify на Linux Mint: socks5://127.0.0.1:12334
TELEGRAM_PROXY_URL=
HOST_UID=1000
HOST_GID=1000

ACCOUNTS_FILE=/app/config/accounts.toml
DATABASE_PATH=/app/data/mailbot.sqlite3
TIMEZONE=Europe/Moscow
POLL_INTERVAL_SECONDS=60
POLL_CONCURRENCY=3
FIRST_SYNC_HOURS=24
IMPORTANCE_THRESHOLD=70
DIGEST_TIME=21:00

# Необязательно. Без ключа работает локальная классификация по правилам.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Пароли приложений. Не используйте основные пароли от почты.
MAILRU_01_PASSWORD=
